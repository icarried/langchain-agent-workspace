KB_ENV=local
KB_API_HOST=0.0.0.0
KB_API_PORT=8008

KB_DOCS_DIR=data/docs
KB_KB_PRIMARY_NAME=primary
KB_KB_PRIMARY_DESCRIPTION=General project and product knowledge base.
KB_KB_PRIMARY_DOCS_DIR=data/docs/primary
KB_KB_PRIMARY_COLLECTION=knowledge_base_primary
KB_KB_PRIMARY_KEYWORDS=project,product,docs,general
KB_KB_SECONDARY_NAME=secondary
KB_KB_SECONDARY_DESCRIPTION=Support, policy, and operations knowledge base.
KB_KB_SECONDARY_DOCS_DIR=data/docs/secondary
KB_KB_SECONDARY_COLLECTION=knowledge_base_secondary
KB_KB_SECONDARY_KEYWORDS=support,policy,operations,faq
KB_CHROMA_PERSIST_DIR=data/chroma
KB_CHROMA_COLLECTION=knowledge_base

KB_OPENAI_API_KEY=
KB_OPENAI_BASE_URL=https://api.openai.com/v1
KB_CHAT_MODEL=gpt-4o-mini

# Optional separate embedding provider. If empty, embedding calls reuse
# KB_OPENAI_API_KEY and KB_OPENAI_BASE_URL.
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KB_EMBEDDING_MODEL=text-embedding-v4
KB_TOP_K=4
KB_MIN_RELEVANCE_SCORE=0.25

