{
  "name": "kb_chat_demo",
  "description": "Minimal demo flow that forwards a question to kb-api /v1/chat/completions.",
  "version": "0.1",
  "notes": [
    "Conservative placeholder artifact.",
    "Import shape may vary by Langflow version.",
    "Do not move prompt or retrieval logic into Langflow."
  ],
  "components": [
    {
      "id": "question_input",
      "type": "text_input",
      "label": "Question",
      "output": "question"
    },
    {
      "id": "chat_request",
      "type": "http_request",
      "method": "POST",
      "url": "http://kb-api:8008/v1/chat/completions",
      "body": {
        "model": "langchain-knowledge-base-agent",
        "messages": [
          {
            "role": "user",
            "content": "{{question_input.question}}"
          }
        ],
        "stream": false
      }
    },
    {
      "id": "answer_view",
      "type": "text_output",
      "label": "Answer",
      "input": "{{chat_request.choices[0].message.content}}"
    },
    {
      "id": "citations_view",
      "type": "json_output",
      "label": "Citations",
      "input": "{{chat_request.choices[0].message.content}}"
    }
  ]
}

