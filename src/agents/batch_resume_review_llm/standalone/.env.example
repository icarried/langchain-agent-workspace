DEEPSEEK_API_KEY=

# Optional model and OpenAI-compatible endpoint overrides.
BATCH_RESUME_REVIEW_MODEL=deepseek-v4-flash
BATCH_RESUME_REVIEW_BASE_URL=
GPU_STACK_BASE_URL=http://<gpu-stack-host>:8003/v1
GPU_STACK_API_KEY=
BATCH_RESUME_REVIEW_OCR_MODEL=paddleocr-vl-1.6
# Optional; empty reuses GPU_STACK_BASE_URL.
BATCH_RESUME_REVIEW_OCR_BASE_URL=
BATCH_RESUME_REVIEW_OCR_TIMEOUT_SECONDS=180
BATCH_RESUME_REVIEW_OCR_MAX_PAGES=50
BATCH_RESUME_REVIEW_MIN_TEXT_CHARS=12https://api.deepseek.com

# Optional remote resume URL controls.
BATCH_RESUME_REVIEW_ALLOWED_URL_HOSTS=
BATCH_RESUME_REVIEW_MAX_REMOTE_FILE_BYTES=10485760
BATCH_RESUME_REVIEW_REMOTE_TIMEOUT_SECONDS=30
BATCH_RESUME_REVIEW_LOCAL_MINIO_ENDPOINT=
