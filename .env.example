# Copy this file to .env.local and fill values locally.
# Never commit real API keys.

DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GPU_STACK_BASE_URL=http://10.100.5.33:8003/v1
GPU_STACK_API_KEY=
# 仅本机WSL需要；服务器部署保持为空且不要启用local-proxy profile。
GPU_STACK_CONTAINER_PROXY_URL=

# Optional tender review overrides.
TENDER_REVIEW_MODEL=
TENDER_REVIEW_BASE_URL=

# Optional resume review overrides.
RESUME_REVIEW_MODEL=
RESUME_REVIEW_BASE_URL=

# Optional contract review overrides.
CONTRACT_REVIEW_MODEL=
CONTRACT_REVIEW_BASE_URL=

# Optional official document review overrides.
OFFICIAL_DOCUMENT_REVIEW_MODEL=
OFFICIAL_DOCUMENT_REVIEW_BASE_URL=

# Optional smart resume screening overrides.
SMART_RESUME_SCREENING_MODEL=
SMART_RESUME_SCREENING_BASE_URL=

# Optional batch resume review overrides.
BATCH_RESUME_REVIEW_MODEL=
BATCH_RESUME_REVIEW_BASE_URL=
BATCH_RESUME_REVIEW_OCR_MODEL=qwen3.5-ocr
BATCH_RESUME_REVIEW_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BATCH_RESUME_REVIEW_OCR_TIMEOUT_SECONDS=120
BATCH_RESUME_REVIEW_OCR_MAX_PAGES=50
BATCH_RESUME_REVIEW_MIN_TEXT_CHARS=12
BATCH_RESUME_REVIEW_ALLOWED_URL_HOSTS=
BATCH_RESUME_REVIEW_MAX_REMOTE_FILE_BYTES=10485760
BATCH_RESUME_REVIEW_REMOTE_TIMEOUT_SECONDS=30
BATCH_RESUME_REVIEW_LOCAL_MINIO_ENDPOINT=

# Unified OpenAI-compatible agent gateway
AGENT_WORKSPACE_IMAGE=agent-workspace:latest
AGENT_GATEWAY_PORT=8008
AGENT_GATEWAY_API_KEY=
AGENT_GATEWAY_REGISTRY=config/agent_gateway.json
# Optional JSON map: {"model-id":"http://worker:8080"}
AGENT_GATEWAY_UPSTREAM_OVERRIDES=

# Shared remote attachment policy
AGENT_FILE_ALLOWED_HOSTS=
AGENT_FILE_MAX_BYTES=10485760
AGENT_FILE_TIMEOUT_SECONDS=30
# Optional signed-host transport map, e.g. {"signed.example:9000":"http://minio:9000"}
AGENT_FILE_TRANSPORT_OVERRIDES=

# Reusable knowledge base
KB_DATA_ROOT=data/knowledge_bases
KB_NAMESPACE=langchain-knowledge-base-agent
KB_DEFAULT_NAME=default
KB_OPENAI_API_KEY=
KB_OPENAI_BASE_URL=http://10.100.5.33:8003/v1
KB_CHAT_MODEL=deepseek-v4-flash
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_BASE_URL=http://10.100.5.33:8003/v1
KB_EMBEDDING_MODEL=qwen3-vl-embedding-8b
KB_TOP_K=4
KB_MIN_RELEVANCE_SCORE=0.25
# 当前索引加上一版可回滚索引。
KB_VERSION_RETENTION=2

# Department-isolated knowledge-base agent
DEPARTMENT_KB_INTENT_MODEL=qwen3.5-122b-a10b
DEPARTMENT_KB_INTENT_TIMEOUT_SECONDS=60
DEPARTMENT_KB_OCR_MODEL=paddleocr-vl-1.6
DEPARTMENT_KB_OCR_TIMEOUT_SECONDS=180
DEPARTMENT_KB_OCR_MAX_PAGES=100
DEPARTMENT_KB_MIN_LOCAL_TEXT_CHARS=20
DEPARTMENT_KB_MAX_FILES_PER_REQUEST=20
# SSE 长步骤无新阶段事件时的心跳间隔。
DEPARTMENT_KB_STREAM_HEARTBEAT_SECONDS=10
# 生产保持 false；平台通过 MinIO/HTTP(S) 附件 URL 传入文件。
DEPARTMENT_KB_ALLOW_LOCAL_FILES=false
# 独立对象存储：生产建议 true。真实凭证只放 .env.local。
DEPARTMENT_KB_OBJECT_STORE_ENABLED=true
DEPARTMENT_KB_MINIO_ENDPOINT=department-kb-minio:9000
DEPARTMENT_KB_MINIO_ACCESS_KEY=
DEPARTMENT_KB_MINIO_SECRET_KEY=
DEPARTMENT_KB_MINIO_SECURE=false

# Deterministic official-document formatting agent
OFFICIAL_DOCUMENT_FORMATTING_MAX_BYTES=20971520

# Conversational image generation agent
IMAGE_GENERATION_MODEL=qwen-image
IMAGE_EDIT_MODEL=qwen-image-edit
IMAGE_PROMPT_REWRITE_MODEL=qwen3.5-122b-a10b
IMAGE_AGENT_MAX_INPUT_BYTES=10485760
IMAGE_AGENT_TIMEOUT_SECONDS=300

# Direct ComfyUI LTX 2.3 video generation agent
COMFYUI_VIDEO_BASE_URL=http://10.180.26.16:8188
COMFYUI_VIDEO_PUBLIC_BASE_URL=http://10.180.26.16:8188
COMFYUI_VIDEO_REQUEST_TIMEOUT_SECONDS=30
COMFYUI_VIDEO_POLL_INTERVAL_SECONDS=2
COMFYUI_VIDEO_MAX_WAIT_SECONDS=1200
COMFYUI_VIDEO_DEFAULT_SIZE=1280x720
COMFYUI_VIDEO_DEFAULT_SECONDS=5
COMFYUI_VIDEO_DEFAULT_FPS=25
COMFYUI_VIDEO_MAX_SECONDS=20
COMFYUI_VIDEO_MAX_FPS=60
COMFYUI_VIDEO_ALLOWED_SIZES=1280x720,720x1280

# Direct ComfyUI LTX 2.3 image-to-video agent
COMFYUI_I2V_BASE_URL=http://10.180.26.16:8188
COMFYUI_I2V_PUBLIC_BASE_URL=http://10.180.26.16:8188
COMFYUI_I2V_REQUEST_TIMEOUT_SECONDS=30
COMFYUI_I2V_POLL_INTERVAL_SECONDS=2
COMFYUI_I2V_MAX_WAIT_SECONDS=1200
COMFYUI_I2V_DEFAULT_SIZE=1280x720
COMFYUI_I2V_DEFAULT_SECONDS=5
COMFYUI_I2V_DEFAULT_FPS=25
COMFYUI_I2V_MAX_SECONDS=15
COMFYUI_I2V_MAX_FPS=30
COMFYUI_I2V_ALLOWED_SIZES=1280x720,720x1280,1024x1024,1536x864,864x1536,1920x1080,1080x1920
COMFYUI_I2V_MAX_INPUT_IMAGE_BYTES=20971520
COMFYUI_I2V_PROMPT_REWRITE_MODEL=qwen3.5-122b-a10b
COMFYUI_I2V_PROMPT_REWRITE_TIMEOUT_SECONDS=90

# Optional LangChain / LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-workspace-dev
