{
  "mcp_servers": [
    {
      "id": "workspace-mcp-gateway",
      "upstream": "http://mcp-gateway:8080/mcp",
      "health_upstream": "http://mcp-gateway:8080",
      "default": true
    }
  ],
  "mcp_backends": [
    {
      "id": "department-knowledge-base",
      "upstream": "http://department-knowledge-base:8080/mcp"
    },
    {
      "id": "batch-resume-review",
      "upstream": "http://batch-resume-review:8080/mcp",
      "prefix": "batch_resume",
      "tool_names": {
        "review_resumes": "review"
      }
    },
    {
      "id": "official-document-formatting",
      "upstream": "http://official-document-formatting:8080/mcp",
      "prefix": "official_document",
      "tool_names": {
        "format_document": "format"
      }
    }
  ],
  "models": [
    {
      "id": "batch-resume-review-agent",
      "app": "src.agents.batch_resume_review_llm.openai_compatible_api:app",
      "upstream": "http://batch-resume-review:8080"
    },
    {
      "id": "tender-format-review-agent",
      "app": "src.agents.tender_format_review.openai_compatible_api:app",
      "upstream": "http://tender-format-review:8080"
    },
    {
      "id": "smart-resume-screening-agent",
      "app": "src.agents.smart_resume_screening.openai_compatible_api:app",
      "upstream": "http://smart-resume-screening:8080"
    },
    {
      "id": "contract-review-agent",
      "app": "src.agents.contract_review.openai_compatible_api:app",
      "upstream": "http://contract-review:8080"
    },
    {
      "id": "official-document-review-agent",
      "app": "src.agents.official_document_review.openai_compatible_api:app",
      "upstream": "http://official-document-review:8080"
    },
    {
      "id": "official-document-formatting-agent",
      "app": "src.agents.official_document_formatting.openai_compatible_api:app",
      "upstream": "http://official-document-formatting:8080"
    },
    {
      "id": "langchain-knowledge-base-agent",
      "app": "src.agents.langchain_knowledge_base.openai_compatible_api:app",
      "upstream": "http://langchain-knowledge-base:8080"
    },
    {
      "id": "department-knowledge-base-agent",
      "app": "src.agents.department_knowledge_base.openai_compatible_api:app",
      "upstream": "http://department-knowledge-base:8080"
    },
    {
      "id": "image-generation-agent",
      "app": "src.agents.image_generation.openai_compatible_api:app",
      "upstream": "http://image-generation:8080"
    },
    {
      "id": "comfyui-video-generation-agent",
      "app": "src.agents.comfyui_video_generation.openai_compatible_api:app",
      "upstream": "http://comfyui-video-generation:8080"
    },
    {
      "id": "comfyui-image-to-video-agent",
      "app": "src.agents.comfyui_image_to_video.openai_compatible_api:app",
      "upstream": "http://comfyui-image-to-video:8080"
    }
  ]
}
